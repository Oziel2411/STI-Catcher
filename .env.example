# =============================================================================
# STI-Catcher — configuración
# Copiá este archivo a .env (scripts/setup.ps1 lo hace si no existe).
# Las rutas relativas se resuelven contra la carpeta de este archivo.
# Si el server encuentra un valor inválido, no arranca y dice cuál es.
# =============================================================================

# development | production
#   production: sirve la web compilada (apps/web/dist) y loguea solo a archivo.
NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Red --------------------------------------------------------------------
# Sin HTTPS solo se permite 127.0.0.1 / localhost (desarrollo).
# En el servidor: HOST=0.0.0.0 y configurar el certificado (ver docs/DEPLOY.md).
HOST=127.0.0.1
PORT=3000

# Certificado y clave PEM (mkcert o CA interna). Van juntos: las dos o ninguna.
# Con HTTPS se habilita HTTP/2 automáticamente.
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# --- Carpetas -----------------------------------------------------------------
# En el servidor conviene ponerlas fuera del código, p. ej. E:\STI-Catcher\storage
# Archivos descargados, convertidos y grabados.
STORAGE_DIR=./storage
# Base de datos SQLite.
DATA_DIR=./data
# Logs de la aplicación (rotan a diario, se guardan 14).
LOG_DIR=./logs
# Binarios externos: yt-dlp.exe, ffmpeg.exe, ffprobe.exe y deno.exe.
# scripts/setup.ps1 los descarga acá. Deno siempre se toma de esta carpeta.
BIN_DIR=./bin

# Opcional: rutas a un ejecutable específico. Vacío = <BIN_DIR>\<nombre>.exe
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# --- Límites ------------------------------------------------------------------
# Trabajos pesados en paralelo (descargas, conversiones). 1 a 8.
MAX_CONCURRENT_JOBS=2
# Tamaño máximo de un archivo subido para convertir, en MB.
MAX_UPLOAD_MB=2048
# Días que se conservan los archivos generados. 0 = nunca se borran.
RETENTION_DAYS=14
# Espacio libre mínimo en el disco de STORAGE_DIR para aceptar un trabajo nuevo, en GB.
MIN_FREE_DISK_GB=5

# --- Descargas ----------------------------------------------------------------
# Extractores de yt-dlp, separados por comas. "-generic" deshabilita la descarga
# desde cualquier página web: solo se aceptan sitios con soporte propio
# (YouTube, Instagram, X, etc.). Es la principal protección para que la app no
# se use para acceder a recursos de la red interna.
YTDLP_EXTRACTORS=default,-generic
# Rechazar links que apunten a IPs de la red interna o a este servidor (true/false).
# Segunda capa de protección; dejar en true salvo que haya un motivo concreto.
BLOCK_PRIVATE_URLS=true

# --- GIF ----------------------------------------------------------------------
# Un GIF largo o grande pesa cientos de MB: topes para la conversión a GIF.
# Duración máxima del fragmento, en segundos.
GIF_MAX_SECONDS=30
# Cuadros por segundo máximos (por defecto se proponen 10).
GIF_MAX_FPS=15
# Ancho máximo en píxeles (por defecto se proponen 480).
GIF_MAX_WIDTH=800

# Grabación de pantalla: si no llegan fragmentos durante estos minutos (pestaña
# cerrada, PC apagada), se procesa lo recibido. 1 a 60.
RECORDING_IDLE_MINUTES=2
